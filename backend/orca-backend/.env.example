# --- Demo-day switches ---
# FORCE_MOCK=true  -> never call the internet; serve bundled synthetic sample data (labelled data_mode="mock")
FORCE_MOCK=false
# Enables ?scenario=calm|rough|storm on endpoints (forces labelled mock data so you can demo an "Unsafe" verdict)
DEMO_SCENARIOS=true

# --- Data / cache ---
CACHE_TTL_MIN=30
STALE_MAX_HOURS=72
HTTP_TIMEOUT_S=8

# --- Behaviour ---
DEFAULT_PLACE=veraval
BOUNDARY_ALERT_KM=15
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Optional LLM (any OpenAI-compatible endpoint, e.g. Ollama at http://localhost:11434/v1) ---
# Leave empty to use rule-based template answers only.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
